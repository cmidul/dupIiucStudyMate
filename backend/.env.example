# ==============================================================================
# AI Learning Assistant - Environment Configuration Template
# Safe placeholder names only. NEVER commit actual production keys or secrets.
# Copy this file to `backend/.env` and fill in your actual credentials.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Security: Secret key for signing sessions and JWT tokens (minimum 32 characters)
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-session-signing

# Database Connection (Async SQLAlchemy URL)
# SQLite for local development/testing: sqlite+aiosqlite:///./learning_assistant.db
# PostgreSQL for production: postgresql+asyncpg://postgres:postgres@localhost:5432/learning_assistant
DATABASE_URL=sqlite+aiosqlite:///./learning_assistant.db

# AI Provider Settings
# AI_DEFAULT_PROVIDER: gemini, groq, or mock
AI_DEFAULT_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock

# Google Gemini API (Required if AI_DEFAULT_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_TEXT=gemini-2.0-flash
AI_MODEL_VISION=gemini-2.0-flash

# Groq API (Optional fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_TEXT=llama-3.3-70b-versatile

# Telegram Bot Integration (Required for Telegram bot features)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_BOT_USERNAME=ai_learning_assistant_bot
TELEGRAM_BOT_SECRET=your_internal_bot_service_secret_here

# Redis & Cache (Optional in early dev, required for background workers)
REDIS_URL=redis://localhost:6379/0

# Private Local Storage
STORAGE_LOCAL_DIR=./storage/uploads

