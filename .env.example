# ==============================================================================
# AI Learning Assistant - Environment Configuration Template (.env.example)
# Safe placeholder names only. NEVER commit actual production keys or secrets.
# Copy this file to `backend/.env` and paste your actual API credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Security: Secret key for signing sessions and JWT tokens (minimum 32 characters)
APP_SECRET_KEY=dev-insecure-secret-key-must-be-changed-in-production-32chars

# Database Connection (Async SQLAlchemy URL)
DATABASE_URL=sqlite+aiosqlite:///./learning_assistant.db

# AI Provider Settings (gemini, groq, or mock)
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDER=mock

# Google Gemini API (Get a free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_TEXT=gemini-2.0-flash
AI_MODEL_VISION=gemini-2.0-flash

# Groq API (Get a free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_TEXT=llama-3.3-70b-versatile

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_BOT_USERNAME=ai_learning_assistant_bot

# Storage Directory
STORAGE_LOCAL_DIR=./storage/uploads

